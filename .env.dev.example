# 开发环境（复制为 .env.dev 使用；start-dev 脚本会在端口被占时自动 +1 并回写）
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# 前端 Vite dev server 端口；前端通过 VITE_API_PORT 反查后端地址，禁止硬编码
FRONTEND_PORT=5173
VITE_API_PORT=8000

# 启动时自动补齐的后端可选依赖（逗号分隔，start-dev 每次启动都会确保装好）。
#   server     - Web UI / REST 所需（fastapi + uvicorn），必备
#   browser    - 自动获取 Cookie、浏览器兜底翻页（playwright，另会下载浏览器内核）
#   transcribe - 视频转写（openai-whisper，体积较大）
#   dev        - 测试与 lint（pytest + ruff）
UV_EXTRAS=server
